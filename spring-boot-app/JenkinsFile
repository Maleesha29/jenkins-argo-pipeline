pipeline {
  agent {
    //run pipeline inside a docker container
    docker {
      image 'maleesha1129/jenkins-argo-pipeline:v1'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock' //mounts the host's Docker socket inside the Jenkins agent container
    }
  }

  stages {
    stage ('Checkout') {
      steps {
        sh 'exho passed'
        git branch: 'main', url: 'https://github.com/Maleesha29/jenkins-argo-pipeline.git'
      }
    }

    stage ('Build and Test') {
      steps {
        sh 'ls -ltr' //the files in detailed format, sorted from oldest modified to newest.
        ch 'cd spring-boot-app && mvn clean package'
      }
    }

    stage ('Static Code Analysis') {
      environment {
        SONAR_URL = "http://localhost:9000/"
      }
      steps {
        withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
          sh 'cd apring-bootapp && mvn sonar:sonar -Dsonar.login=$SONAR_AUTH_TOKEN -Dsonar.host.url=${SONAR_URL}'
          //navigate to the app and run sonar scan
        }
      }
    }

    stage ('Build and Push Docker Image') {
      environment{
        DOCKER_IMAGE = "maleesha1129/jenkins-argo-pipeline:${BUILD_NUMBER}"
        REGISTRY_CREDENTIALS = credentials('docker-cred')
      }
      steps {
        script {
          sh 'cd apring-bootapp && docker build -t ${DOCKER_IMAGE}'
          def dockerImage = docker.image("${DOCKER_IMAGE}") //give me a handle/reference to the Docker image whose name is stored in DOCKER_IMAGE
          docker.withRegistry('https://index.docker.io/v1/', 'docker-cred') {
            dockerImage.push()
          }
        }
      }
    }
    
    stage ('Update Deployment File') {
      environment {
        GIT_REPO_NAME = "jenkins-argo-pipeline"
        GIT_USER_NAME = "Maleesha29"
      }

      steps {
        withCredentials([string(credentialsId: 'github', variable: 'github')]) {
          sh '''
                    git config user.email "lishan.m29@gmail.com"
                    git config user.name "Maleesha29"
                    BUILD_NUMBER=${BUILD_NUMBER}
                    sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" spring-boot-app-manifests/deployment.yml //update the Docker image tag in Kubernetes deployment
                    git add spring-boot-app-manifests/deployment.yml
                    git commit -m "Update deployment image to version ${BUILD_NUMBER}"
                    git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main
                '''
        }
      }
    }
  }
}