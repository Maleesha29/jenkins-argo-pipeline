pipeline {
  agent any

  stages {
    stage ('Checkout') {
      steps {
        bat 'echo Checkout Complete'
      }
    }

    stage ('Build and Test') {
      steps {
        bat 'dir'
        bat 'cd spring-boot-app && mvn clean package'
      }
    }

    stage ('Static Code Analysis') {
      environment {
        SONAR_URL = "http://localhost:9000/"
      }
      steps {
        withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
          bat 'cd spring-boot-app && mvn sonar:sonar -Dsonar.login=%SONAR_AUTH_TOKEN% -Dsonar.host.url=%SONAR_URL%'
          //navigate to the app and run sonar scan
        }
      }
    }

    stage ('Build and Push Docker Image') {
      environment{
        DOCKER_IMAGE = "maleesha1129/jenkins-argo-pipeline:${BUILD_NUMBER}"
      }
      steps {
        script {
          bat 'cd spring-boot-app && docker build -t %DOCKER_IMAGE% .'
          def dockerImage = docker.image("${DOCKER_IMAGE}") //give me a handle/reference to the Docker image whose name is stored in DOCKER_IMAGE
          docker.withRegistry('https://index.docker.io/v1/', 'docker-cred') {
            dockerImage.push()
          }
        }
      }
    }
    
    stage ('Update Deployment File') {
    environment {
        GIT_REPO_NAME = "jenkins-argo-pipeline"
        GIT_USER_NAME = "Maleesha29"
    }
    steps {
        withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
            bat '''
                echo ========================================
                echo Updating Kubernetes Deployment
                echo Build Number: %BUILD_NUMBER%
                echo ========================================

                git config user.email "lishan.m29@gmail.com"
                git config user.name "Maleesha29"

                echo.
                echo Checking deployment file...
                dir spring-boot-app-manifests

                echo.
                echo Current deployment:
                type spring-boot-app-manifests\\deployment.yaml

                echo.
                echo Updating Docker image tag...

                powershell -Command "(Get-Content 'spring-boot-app-manifests\\deployment.yaml') -replace 'maleesha1129/jenkins-argo-pipeline:[^\\s]+', 'maleesha1129/jenkins-argo-pipeline:%BUILD_NUMBER%' | Set-Content 'spring-boot-app-manifests\\deployment.yaml'"

                echo.
                echo Updated deployment:
                type spring-boot-app-manifests\\deployment.yaml

                echo.
                echo Adding deployment file to Git...
                git add spring-boot-app-manifests/deployment.yaml

                echo.
                echo Committing changes...
                git commit -m "Update deployment image to version %BUILD_NUMBER%"

                echo.
                echo Pushing changes to GitHub...
                git push https://%GITHUB_TOKEN%@github.com/%GIT_USER_NAME%/%GIT_REPO_NAME%.git HEAD:main
            '''
          }
        }
    }
  }
}